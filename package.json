{
  "name": "goal-calendly",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "init:firestore": "tsx src/scripts/initializeFirestore.ts",
    "test:firestore": "tsx src/scripts/testFirestore.ts",
    "diagnose:firestore": "tsx src/scripts/diagnoseFirestore.ts",
    "diagnose:isolation": "tsx src/scripts/diagnoseUserIsolation.ts",
    "functions:install": "npm --prefix functions install",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions test",
    "emulators": "firebase emulators:start --only functions,firestore,auth",
    "functions:test:manual-ping": "node functions/tests/ping.manual.mjs",
    "test:rules": "node --test tests/firestore.rules.test.mjs",
    "test:timers": "node --test tests/timers.test.mjs tests/timerNotifications.test.mjs tests/timerSettings.browser.test.mjs",
    "test:celebrations": "tsx --test tests/celebrations.test.ts && node --test tests/celebrations.browser.test.mjs",
    "test:goal-limits": "node --test functions/tests/goalLimits.test.mjs",
    "test:webhook": "node --test functions/tests/stripeWebhook.test.mjs",
    "test:reconcile": "node --test functions/tests/reconcileSubscriptions.test.mjs",
    "test:checkout-portal": "node --test functions/tests/checkoutAndPortal.test.mjs",
    "test:admin-access": "node --test functions/tests/adminAccessManagement.test.mjs",
    "test:migrate": "node --test functions/tests/migrateSubscriptions.test.mjs",
    "test:emulator-suite": "node --test --test-concurrency=1 tests/firestore.rules.test.mjs functions/tests/goalLimits.test.mjs functions/tests/stripeWebhook.test.mjs functions/tests/reconcileSubscriptions.test.mjs functions/tests/checkoutAndPortal.test.mjs functions/tests/adminAccessManagement.test.mjs functions/tests/migrateSubscriptions.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-toast": "^1.1.5",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "dotenv": "^17.0.1",
    "firebase": "^11.10.0",
    "lucide-react": "^0.344.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^2.2.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "9.9.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "playwright": "^1.63.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "^1.0.1"
  }
}
