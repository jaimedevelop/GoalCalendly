# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
firebase-export-*/
functions/lib/
functions/.env
# Guard against a stray `tsc` invocation emitting compiled output directly
# into shared/ instead of functions/lib/shared/ (happened once — see step 7
# progress log). shared/*.ts is the only source of truth here.
shared/*.js
shared/*.js.map
functions/.env.*
!functions/.env.example

# Stripe resource inventories are non-secret but environment-specific
# generated output — review before committing rather than auto-tracking.
config/stripe-resources.*.json
!config/stripe-resources.example.json

# Throwaway staging-rehearsal scripts/screenshots (Playwright, ad-hoc checks)
.scratch/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

