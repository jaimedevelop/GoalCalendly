{
  "name": "goal-calendly-functions",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "20"
  },
  "main": "lib/functions/src/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "shell": "npm run build && firebase functions:shell",
    "test": "node --test --experimental-strip-types tests/**/*.test.ts",
    "lint": "eslint .",
    "stripe:provision": "node --experimental-strip-types scripts/provisionStripe.ts",
    "stripe:verify": "node --experimental-strip-types scripts/verifyStripeConfig.ts"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "stripe": "^17.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.5.3"
  }
}
