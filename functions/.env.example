# Non-secret backend configuration placeholders.
# Actual values are set per environment via
# `.env.<project-id>` files consumed by Cloud Functions, NOT committed here.
# Secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET) go through
# `firebase functions:secrets:set`, never into an .env file. See
# credentials.md step 7 and admin_subscriptions.md section 5, step 2.

# Stripe Price IDs (non-secret product identifiers, not authentication keys)
STRIPE_PRICE_PRO_MONTHLY=price_REPLACE
STRIPE_PRICE_PRO_ANNUAL=price_REPLACE
STRIPE_PRICE_PLATINUM_MONTHLY=price_REPLACE
STRIPE_PRICE_PLATINUM_ANNUAL=price_REPLACE
STRIPE_PORTAL_CONFIGURATION_ID=REPLACE_WITH_PORTAL_CONFIGURATION_ID

# Allowed frontend origin for Checkout/Portal return URLs and CORS
APP_ORIGIN=https://REPLACE_WITH_DEPLOYED_FRONTEND_URL

# Feature switch: keep false until roadmap step 11 cutover checks pass
CHECKOUT_ENABLED=false

# Exact backend endpoint for stripe:verify (required for --env live)
STRIPE_WEBHOOK_URL=https://us-central1-REPLACE_PROJECT.cloudfunctions.net/stripeWebhook
